# Prava Payments (Sandbox)
PRAVA_API_KEY=sk_sandbox_your_key_here
PRAVA_API_URL=https://sandbox.api.prava.space
PRAVA_SANDBOX_CARD=4622943123137789
PRAVA_SANDBOX_CVV=757
PRAVA_SANDBOX_EXPIRY=12/27
PRAVA_SANDBOX_OTP=456789
# Mock checkout links are disabled by default. Keep this false when using Prava.
# Set both flags to true only for an explicitly local, offline demo.
PRAVA_ENABLE_MOCK_FALLBACK=false
PRAVA_ALLOW_MOCK_APPROVAL=false

# OpenAI (Hackathon credits)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# LLM Provider (groq | openai) — start on groq, flip to openai once confirmed working
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Linq Messaging
LINQ_API_KEY=your-linq-api-key
LINQ_PHONE_NUMBER=+1XXXXXXXXXX

# NANDA Index
NANDA_INDEX_URL=https://index.projectnanda.org

# Cloudinary (private/authenticated asset storage — falls back to local disk if unset)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Server
PORT=3000
LIVE_AGENT_PORT=9001
JWT_SECRET=weft-marketplace-jwt-secret-change-in-production

# Weft Marketplace Merchant Info (for Prava sessions)
WEFT_MERCHANT_NAME=Weft Agentic Marketplace
WEFT_MERCHANT_URL=https://weft.marketplace
WEFT_MERCHANT_COUNTRY=US
